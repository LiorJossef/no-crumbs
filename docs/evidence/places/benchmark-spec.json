  "owner": "maps-geospatial",
  "purpose": "Fixed benchmark for decision D2 (place resolution). Each case is a candidate string as an LLM would emit it from a TikTok caption, plus the hints available at resolution time. Run identically against every candidate provider; score top-1 and top-3.",
  "scoring": {
    "top1": "The provider's first result IS the intended venue (same business, same branch when a branch is specified).",
    "top3": "The intended venue appears in the first three results.",
    "branch_ok": "For multi-branch cases with no branch hint, ANY genuine branch of the correct business counts as correct; the case is additionally scored on whether the provider surfaced >1 branch (needed for our disambiguation UI).",
    "no_resolution": "For cases with expect=NONE, correct means the provider returns nothing, or our scorer rejects everything below threshold. A confident wrong POI is a FALSE POSITIVE and is the most damaging failure mode.",
    "record": ["provider", "case_id", "query_sent", "top1_name", "top1_lat", "top1_lon", "top1_category", "top1_provider_id", "verdict_top1", "verdict_top3", "n_results", "latency_ms"]
  },
  "notes": "expected_name is the venue's canonical name; expected_area is the neighbourhood used for human adjudication. Labels marked \"label_confidence\": \"low\" must be re-checked by a human before the case is used to compare providers.",
