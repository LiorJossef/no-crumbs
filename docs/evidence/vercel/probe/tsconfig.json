{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "noEmit": true, "jsx": "preserve",
    "skipLibCheck": true, "esModuleInterop": true, "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"]
}
