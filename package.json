{
  "name": "p-002",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run check:layers && npm run check:migrations && npm run test",
    "check:layers": "bash scripts/check-layer-guard.sh",
    "check:migrations": "bash scripts/check-migration-grants.sh",
    "db:reset": "supabase db reset",
    "db:test": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/0008_policy_tests.sql",
    "db:inventory": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/inventory.sql",
    "db:verify": "npm run db:reset && npm run db:test && npm run db:inventory",
    "db:push:staging": "bash scripts/db-push.sh staging",
    "db:push:prod": "bash scripts/db-push.sh prod",
    "db:status:staging": "supabase migration list --project-ref \"${SUPABASE_PROJECT_REF_STAGING:-jfuqjzubphfhfleqnkno}\"",
    "db:status:prod": "supabase migration list --project-ref \"${SUPABASE_PROJECT_REF_PROD:-vtboskegexinvhasghri}\"",
    "db:inventory:staging": "bash scripts/db-inventory-remote.sh staging",
    "db:inventory:prod": "bash scripts/db-inventory-remote.sh prod",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "supabase": "^2.115.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
