# ---------------------------------------------------------------------------
# P-002 env-var matrix. Copy to .env.local for local development.
# Full matrix, including which value differs per environment, is in README.md.
# Rule: anything without the NEXT_PUBLIC_ prefix must never reach the browser.
# ---------------------------------------------------------------------------

# --- Supabase (MS2 creates the project; MS5 creates the schema) -------------
# Public: safe in the browser. Authorisation is RLS, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only. Bypasses RLS. Never referenced from src/ui/** or a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM extraction (D7: Anthropic claude-haiku-4-5, docs/09; L0-F4-T2 adds the ------
# provider switch below — see integrations/llm/place-extractor-factory.ts's header for
# why this is one factory, not an if/else) -------------------------------------------
# 'anthropic' (default, production) or 'gemini' (hosted, see
# integrations/llm/gemini.place-extractor.ts's header).
LLM_PROVIDER=anthropic
# SECRET: server only, used solely by integrations/llm/anthropic.place-extractor.ts
ANTHROPIC_API_KEY=
# Optional override of the hosted model; defaults to claude-haiku-4-5 in code.
ANTHROPIC_MODEL=
# SECRET: server only, used solely by integrations/llm/gemini.place-extractor.ts;
# only read when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Map tiles (D2: MapLibre GL + Protomaps, docs/06) ----------------------
# Public by design (docs/06 §risk 7). Domain-restricted at the provider.
NEXT_PUBLIC_PROTOMAPS_API_KEY=

# --- Build identity (set automatically on Vercel) --------------------------
NEXT_PUBLIC_STAGE=local
NEXT_PUBLIC_COMMIT_SHA=dev

# --- Database migration operator vars (docs/db-migration-runbook.md) --------
# NOT application config: nothing in src/ reads these, and none of them belongs in
# Vercel's env store — Vercel builds never run migrations. They exist only in an
# untracked .env.local or in the operator's shell.
#
# SECRET: session-mode pooler URIs, password included. Consumed by
# `npm run db:push:staging|prod` and `npm run db:inventory:staging|prod`.
# Source: Supabase dashboard -> project -> Connect -> session pooler.
# Each string MUST contain its own project ref; the scripts refuse it otherwise,
# because an empty value would silently fall back to the local container and
# "prove" a hosted project that was never contacted.
STAGING_DATABASE_URL=
PROD_DATABASE_URL=
# Used by `npm run db:test` / `db:inventory` when pointing them at a non-default
# local database. Unset means the local Supabase container (…@127.0.0.1:54322).
DATABASE_URL=
# NOT secret — the project ref is the host of NEXT_PUBLIC_SUPABASE_URL. Both have
# working defaults in scripts/db-env.sh (docs/ms4-database.md §5); set these only
# if a Supabase project is recreated.
SUPABASE_PROJECT_REF_STAGING=
SUPABASE_PROJECT_REF_PROD=
# SECRET: `supabase login` token and the project DB password. Only needed to keep
# the CLI non-interactive.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
