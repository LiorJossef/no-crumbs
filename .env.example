# ---------------------------------------------------------------------------
# P-002 env-var matrix. Copy to .env.local for local development.
# Full matrix, including which value differs per environment, is in README.md.
# Rule: anything without the NEXT_PUBLIC_ prefix must never reach the browser.
# ---------------------------------------------------------------------------

# --- Supabase (MS2 creates the project; MS5 creates the schema) -------------
# Public: safe in the browser. Authorisation is RLS, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only. Bypasses RLS. Never referenced from src/ui/** or a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM extraction (D7: Anthropic claude-haiku-4-5, docs/09) --------------
# SECRET: server only, used solely by integrations/llm/anthropic.place-extractor.ts
ANTHROPIC_API_KEY=

# --- Map tiles (D2: MapLibre GL + Protomaps, docs/06) ----------------------
# Public by design (docs/06 §risk 7). Domain-restricted at the provider.
NEXT_PUBLIC_PROTOMAPS_API_KEY=

# --- Build identity (set automatically on Vercel) --------------------------
NEXT_PUBLIC_STAGE=local
NEXT_PUBLIC_COMMIT_SHA=dev
