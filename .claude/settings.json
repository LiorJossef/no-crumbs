{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "auto",

    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(node:*)",
      "Bash(tsx:*)",
      "Bash(python3:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push -u origin:*)",

      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api -X GET:*)",

      "Bash(supabase migration list:*)",
      "Bash(supabase status:*)",
      "Bash(supabase start)",

      "Bash(npm run db:push:staging:*)",
      "Bash(npm run db:push:prod:*)",
      "Bash(npm run db:reset:*)",
      "Bash(npm run db:verify:*)",
      "Bash(npm run merge:pr:*)",
      "Bash(bash scripts/db-push.sh:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase link:*)",
      "Bash(supabase stop:*)",
      "Bash(docker:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr close:*)",
      "Bash(psql:*)",

      "Edit(CLAUDE.md)",
      "Edit(docs/security.md)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/settings.json)",
      "Edit(.github/workflows/**)",
      "Edit(scripts/merge-pr.sh)",
      "Edit(scripts/check-agents.sh)",
      "Edit(scripts/check-layer-guard.sh)",
      "Edit(scripts/check-migration-grants.sh)",
      "Edit(scripts/check-schema.sh)",
      "Edit(scripts/db-push.sh)",
      "Edit(scripts/db-env.sh)",
      "Edit(supabase/tests/**)",
      "Edit(.githooks/**)",
      "Edit(.gitignore)",

      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(sed:*)",
      "Bash(awk:*)", "Bash(grep:*)", "Bash(rg:*)", "Bash(find:*)", "Bash(wc:*)",
      "Bash(sort:*)", "Bash(uniq:*)", "Bash(diff:*)", "Bash(jq:*)", "Bash(echo:*)",
      "Bash(date:*)", "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(chmod:*)",
      "Bash(lsof:*)", "Bash(ps:*)", "Bash(kill:*)", "Bash(xargs:*)",

      "WebSearch",
      "WebFetch"
    ],

    "_ask_note": [
      "Owner ruling 2026-08-30: 'soften the guards, let us work more freely.' The ask list was",
      "emptied and its 30 rules moved into allow above. Ask rules are announcements, not",
      "protections — they fired constantly and guarded nothing on their own.",
      "",
      "Owner ruling 2026-08-30, later: 'remove all that you can, keep the ones that will break.'",
      "The deny list went from 63 rules to 23. What remains is exactly the set asserted by name in",
      "scripts/check-claude-config.sh, so removing any one of them turns npm run verify red — that",
      "is the whole selection rule, and it is deliberate rather than a judgement about danger.",
      "Everything not asserted was removed, including four bulk git-add rules added hours earlier.",
      "Do not cite a deny rule from memory; read this list. See docs/claude-code-setup.md §2.1."
    ],
    "ask": [],

    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(ALLOW_MAIN_PUSH=1:*)",

      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git config:*)",

      "Bash(cat .env:*)",
      "Bash(grep .env:*)",
      "Bash(source .env:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git revert:*)",

      "Bash(gh pr merge:*)",
      "Bash(gh api -X POST:*)",
      "Bash(gh api -X DELETE:*)",

      "Bash(supabase secrets:*)",
      "Bash(vercel:*)",

      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ensure-git-hooks.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
